# Copy this file to .env and replace the placeholder, or run ./setup-env.sh.
# SECRET_KEY must be unique for each installation and must never be committed.
SECRET_KEY=replace-with-a-long-random-secret

# Optional: change these only when running a second instance on the same Docker host.
# APP_PORT=8001
# MONGODB_PORT=27018
# MONGODB_URI=mongodb://127.0.0.1:27018/jama-dashboard-test
# APP_CONTAINER_NAME=jama-dashboard-test
# MONGO_CONTAINER_NAME=jama-dashboard-test_mongodb

# Default database for a single instance.
MONGODB_URI=mongodb://127.0.0.1:27017/jama-dashboard
# Optional trusted remote app catalog.
# APP_CATALOG_BASE_URL=https://example.invalid/catalog
# VITE_APP_CATALOG_URL=https://example.invalid/catalog/apps.json